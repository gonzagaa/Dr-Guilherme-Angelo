# ============================================================
# Backend CAPI — variáveis de ambiente
# ------------------------------------------------------------
# Este arquivo é um MODELO. Não coloque valores reais aqui e não
# commite um .env com segredos. Em produção, configure tudo em:
#   Vercel → Project → Settings → Environment Variables
# ============================================================

# ID do Pixel do Meta. Precisa ser o MESMO que está no <head> das 4 LPs,
# senão o evento server-side cai num pixel diferente do evento do navegador
# e a deduplicação nunca acontece.
# Obrigatória.
FB_PIXEL_ID=

# Token de acesso da Conversions API, gerado no Events Manager
# (Configurações → Conversions API → Gerar token de acesso).
# SECRETO: vive só aqui, nunca no HTML/JS do site.
# Tokens podem expirar — se os eventos pararem de ser aceitos com
# erro de OAuth nos logs, gere um novo e atualize esta variável.
# Obrigatória.
FB_CAPI_TOKEN=

# Origens autorizadas a chamar este backend, separadas por vírgula.
# Precisa bater EXATAMENTE com o domínio de produção, incluindo o
# esquema e o "www" (ou a falta dele). Liste as duas variantes se as
# duas atenderem.
# Se ficar vazia, o CORS libera "*" (funciona, mas menos seguro).
# Ex.: https://drguilhermeangelo.com.br,https://www.drguilhermeangelo.com.br
# Recomendada.
ALLOWED_ORIGINS=

# Código de teste do Events Manager (aba "Testar eventos").
#
# ⚠️ DEVE FICAR VAZIO EM PRODUÇÃO. ⚠️
#
# Enquanto esta variável tiver qualquer valor, TODOS os eventos enviados
# por este backend são roteados para a aba "Testar eventos" e NÃO aparecem
# na visão normal do Events Manager — o que faz o CompleteRegistration
# parecer que "não está ativando" mesmo quando está sendo enviado.
# Use só durante o teste e apague o valor logo depois.
# Opcional.
FB_TEST_EVENT_CODE=
